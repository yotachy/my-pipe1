# data/ 폴더 보안 설정
# JSON만 허용, 나머지 차단

<FilesMatch "\.(log|lock|tmp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# JSON 파일에 올바른 Content-Type 설정
<FilesMatch "\.(json)$">
  <IfModule mod_headers.c>
    Header set Content-Type "application/json; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</FilesMatch>
